{
  "name": "@spkm/ui",
  "type": "module",
  "version": "1.2.1",
  "description": "Shared Sparkmate React UI components and Tailwind CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sparkmate/ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/ui/button.d.ts",
      "import": "./dist/components/ui/button.js"
    },
    "./sidebar": {
      "types": "./dist/components/ui/sidebar.d.ts",
      "import": "./dist/components/ui/sidebar.js"
    },
    "./nav-main": {
      "types": "./dist/components/nav/nav-main.d.ts",
      "import": "./dist/components/nav/nav-main.js"
    },
    "./nav-user": {
      "types": "./dist/components/nav/nav-user.d.ts",
      "import": "./dist/components/nav/nav-user.js"
    },
    "./app-sidebar": {
      "types": "./dist/components/app-sidebar.d.ts",
      "import": "./dist/components/app-sidebar.js"
    },
    "./agent-chat": {
      "types": "./dist/components/agent-chat.d.ts",
      "import": "./dist/components/agent-chat.js"
    },
    "./release-badge": {
      "types": "./dist/components/release-badge.d.ts",
      "import": "./dist/components/release-badge.js"
    },
    "./status-row": {
      "types": "./dist/components/status-row.d.ts",
      "import": "./dist/components/status-row.js"
    },
    "./use-mobile": {
      "types": "./dist/hooks/use-mobile.d.ts",
      "import": "./dist/hooks/use-mobile.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./types/navigation": {
      "types": "./dist/types/navigation.d.ts",
      "import": "./dist/types/navigation.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    },
    "./components/nav/*": {
      "types": "./dist/components/nav/*.d.ts",
      "import": "./dist/components/nav/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config-loader tsx && node ./scripts/copy-styles.mjs",
    "dev": "tsdown --config-loader tsx --watch",
    "play": "vite",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "analyze:tree-shaking": "node ./scripts/verify-tree-shaking.mjs",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bumpp": "^11.1.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.76.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  }
}
